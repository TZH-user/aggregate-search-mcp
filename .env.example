# ===== 聚合搜索 MCP — API Keys(填了哪个引擎就启用哪个)=====
# 模板文件:下面的值全是占位符,请把真实 key 填进同目录的 .env(已被 .gitignore 忽略)
# 各平台申请网址与逐步流程见 KEYS.md

# 博查 https://open.bochaai.com (免费 1000 次 + 兑换码再 1000 次;体验包 3.6 元/1000 次)
BOCHA_API_KEY=sk-your-bocha-api-key

# 智谱 https://open.bigmodel.cn (端点 /api/paas/v4/web_search,约 0.01 元/次)
ZHIPU_API_KEY=

# Tavily https://app.tavily.com (每月 1000 次免费)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Serper https://serper.dev (Google SERP,$1/千次起)
SERPER_API_KEY=your-serper-api-key

# 可选:自托管 SearXNG 实例(免 key),留空则禁用
# 注意:该实例必须开启 json 输出格式,否则无法解析
SEARXNG_BASE_URL=

# 可选:海外引擎出网代理(国内引擎始终直连)。
# 留空时按 环境变量 → 7897/7890/10809 端口探测 → Windows 系统代理 依次回退
# AGG_PROXY=http://127.0.0.1:7897

# 可选:强制禁用某引擎(海外源出不去时禁用可省掉每轮超时等待)
# AGG_ENABLE_TAVILY=0
# AGG_ENABLE_SERPER=0

# 可选:智谱搜索引擎编码,默认 search_std
# 可选值 search_std / search_pro / search_pro_sogou / search_pro_quark
# ZHIPU_SEARCH_ENGINE=search_std
